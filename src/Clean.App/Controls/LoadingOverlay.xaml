<UserControl
    x:Class="Clean.App.Controls.LoadingOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Clean.App.Controls">

    <Grid Background="{StaticResource OverlayBackgroundBrush}">
        <controls:LineStrands />

        <StackPanel
            Width="360"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="28">
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="22">
                <controls:LumaSpin Width="44" Height="44" StartStep="0" />
                <controls:LumaSpin Width="44" Height="44" StartStep="1" />
                <controls:LumaSpin Width="44" Height="44" StartStep="2" />
            </StackPanel>

            <StackPanel Spacing="14">
                <TextBlock
                    HorizontalAlignment="Center"
                    CharacterSpacing="40"
                    FontFamily="Bahnschrift"
                    FontSize="56"
                    FontStretch="Condensed"
                    FontWeight="Bold"
                    Text="CLEAN" />

                <Grid Height="1" Background="{StaticResource SegmentEmptyBrush}">
                    <Rectangle Fill="{StaticResource SegmentFilledBrush}" RenderTransformOrigin="0,0.5">
                        <Rectangle.RenderTransform>
                            <ScaleTransform x:Name="FillScale" ScaleX="0" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Grid>

                <Grid>
                    <TextBlock
                        CharacterSpacing="160"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="{x:Bind Message, Mode=OneWay}" />
                    <TextBlock
                        x:Name="PercentText"
                        HorizontalAlignment="Right"
                        CharacterSpacing="160"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Text="0 %" />
                </Grid>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
