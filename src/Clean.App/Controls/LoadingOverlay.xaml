<UserControl
    x:Class="Clean.App.Controls.LoadingOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Clean.App.Controls">

    <Grid Background="{StaticResource OverlayBackgroundBrush}">
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="28">
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="22">
                <controls:LumaSpin Width="44" Height="44" StartStep="0" />
                <controls:LumaSpin Width="44" Height="44" StartStep="1" />
                <controls:LumaSpin Width="44" Height="44" StartStep="2" />
            </StackPanel>

            <StackPanel HorizontalAlignment="Center" Spacing="4">
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource PageTitleTextStyle}"
                    Text="Clean" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource MutedTextStyle}"
                    Text="{x:Bind Message, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
