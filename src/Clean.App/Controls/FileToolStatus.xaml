<UserControl
    x:Class="Clean.App.Controls.FileToolStatus"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Clean.App.Controls">

    <StackPanel Spacing="16">
        <TextBlock
            Foreground="{StaticResource CautionBrush}"
            Style="{StaticResource MutedTextStyle}"
            Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}" />

        <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}">
            <StackPanel Spacing="18">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <controls:LumaSpin Width="26" Height="26" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.PhaseText, Mode=OneWay}" />
                    </StackPanel>
                    <Button
                        Padding="22,8"
                        HorizontalAlignment="Right"
                        Command="{x:Bind ViewModel.CancelCommand}"
                        Content="Annuler"
                        Style="{StaticResource LiquidButtonStyle}" />
                </Grid>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource CardLabelTextStyle}" Text="FICHIERS EXAMINÉS" />
                        <TextBlock Style="{StaticResource CardValueTextStyle}" Text="{x:Bind ViewModel.FilesScannedText, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Style="{StaticResource CardLabelTextStyle}" Text="{x:Bind SecondaryLabel}" />
                        <TextBlock Style="{StaticResource CardValueTextStyle}" Text="{x:Bind ViewModel.SecondaryProgressText, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
                <ProgressBar
                    IsIndeterminate="{x:Bind ViewModel.IsProgressIndeterminate, Mode=OneWay}"
                    Maximum="1"
                    Value="{x:Bind ViewModel.ProgressRatio, Mode=OneWay}" />
                <TextBlock
                    Style="{StaticResource MutedTextStyle}"
                    Text="{x:Bind ViewModel.CurrentPath, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.IsRemoving, Mode=OneWay}">
            <StackPanel Spacing="14">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <controls:LumaSpin Width="26" Height="26" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="Retrait en cours…" />
                    </StackPanel>
                    <Button
                        Padding="22,8"
                        HorizontalAlignment="Right"
                        Command="{x:Bind ViewModel.CancelRemoveCommand}"
                        Content="Arrêter"
                        Style="{StaticResource LiquidButtonStyle}" />
                </Grid>
                <TextBlock Style="{StaticResource CardValueTextStyle}" Text="{x:Bind ViewModel.SecondaryProgressText, Mode=OneWay}" />
                <TextBlock
                    Style="{StaticResource MutedTextStyle}"
                    Text="{x:Bind ViewModel.CurrentPath, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </StackPanel>
        </Border>

        <Border
            BorderBrush="{StaticResource SafeBrush}"
            BorderThickness="3,0,0,0"
            Style="{StaticResource CardStyle}"
            Visibility="{x:Bind ViewModel.IsRemoved, Mode=OneWay}">
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource CardLabelTextStyle}" Text="RETIRÉ" />
                <controls:AnimatedText
                    HorizontalAlignment="Left"
                    Effect="CountUp"
                    FontSize="40"
                    FontWeight="Bold"
                    IsShiny="True"
                    Text="{x:Bind ViewModel.RemovedText, Mode=OneWay}" />
                <TextBlock Style="{StaticResource MutedTextStyle}" Text="{x:Bind ViewModel.RemovedSummary, Mode=OneWay}" />
                <TextBlock
                    Foreground="{StaticResource CautionBrush}"
                    Style="{StaticResource MutedTextStyle}"
                    Text="{x:Bind ViewModel.SkippedRemovalsText, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasSkippedRemovals, Mode=OneWay}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        Padding="22,8"
                        Command="{x:Bind ViewModel.ShowHistoryCommand}"
                        Content="Voir l'historique"
                        Style="{StaticResource LiquidButtonStyle}" />
                    <Button
                        Padding="22,8"
                        Command="{x:Bind ViewModel.AnalyzeCommand}"
                        Content="Analyser à nouveau"
                        Style="{StaticResource LiquidButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
