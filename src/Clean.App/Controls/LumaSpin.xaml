<UserControl
    x:Class="Clean.App.Controls.LumaSpin"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ShapeStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource LoaderStrokeBrush}" />
            <Setter Property="BorderThickness" Value="3" />
        </Style>
    </UserControl.Resources>

    <Viewbox>
        <Canvas Width="65" Height="65">
            <Border x:Name="FirstShape" Style="{StaticResource ShapeStyle}" />
            <Border x:Name="SecondShape" Style="{StaticResource ShapeStyle}" />
        </Canvas>
    </Viewbox>
</UserControl>
