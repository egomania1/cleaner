<UserControl
    x:Class="Clean.App.Controls.StorageDetailCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Clean.App.Controls"
    xmlns:converters="using:Clean.App.Converters"
    xmlns:viewmodels="using:Clean.App.ViewModels">
    <UserControl.Resources>
        <converters:RiskLevelToBrushConverter x:Key="RiskBrush" />
    </UserControl.Resources>

    <Border
        Background="{StaticResource CardBackgroundBrush}"
        BorderBrush="{StaticResource CardBorderBrush}"
        BorderThickness="1"
        CornerRadius="12">
        <Grid x:Name="Layout">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="VisualColumn" Width="*" />
                <ColumnDefinition x:Name="ContentColumn" Width="2*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="VisualPanel" MinHeight="240">
                <Border x:Name="GradientBase" CornerRadius="11,0,0,11" />
                <Border
                    x:Name="GradientGlow"
                    CornerRadius="11,0,0,11"
                    Opacity="0.8" />
            </Grid>

            <StackPanel
                x:Name="ContentPanel"
                Grid.Column="1"
                Padding="28,24,28,28"
                Spacing="16">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Padding="10,4"
                        Command="{x:Bind Detail.BackCommand, Mode=OneWay}"
                        Content="{x:Bind Detail.BackText, Mode=OneWay}"
                        Style="{StaticResource LiquidButtonStyle}"
                        Visibility="{x:Bind Detail.CanGoBack, Mode=OneWay}" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        CharacterSpacing="60"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{x:Bind Detail.Risk, Mode=OneWay, Converter={StaticResource RiskBrush}}"
                        Text="{x:Bind Detail.Verdict, Mode=OneWay}" />
                    <Button
                        Grid.Column="2"
                        Padding="8"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{x:Bind Detail.CloseCommand, Mode=OneWay}"
                        ToolTipService.ToolTip="Fermer">
                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                    </Button>
                </Grid>

                <StackPanel Spacing="8">
                    <TextBlock
                        FontSize="28"
                        FontWeight="Bold"
                        Text="{x:Bind Detail.Name, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <controls:AnimatedText
                            Effect="Decrypt"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="{x:Bind Detail.SizeText, Mode=OneWay}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource MutedTextStyle}"
                            Text="{x:Bind Detail.ShareText, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock
                        FontSize="12"
                        Foreground="{StaticResource MutedTextBrush}"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind Detail.PathText, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind Detail.HasPath, Mode=OneWay}" />
                    <TextBlock
                        FontSize="14"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="{x:Bind Detail.Summary, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="10"
                    Visibility="{x:Bind Detail.IsLoading, Mode=OneWay}">
                    <controls:LumaSpin Width="18" Height="18" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource MutedTextStyle}"
                        Text="Analyse détaillée en cours…" />
                </StackPanel>

                <TextBlock
                    Style="{StaticResource MutedTextStyle}"
                    Text="{x:Bind Detail.LoadingMessage, Mode=OneWay}"
                    Visibility="{x:Bind Detail.HasLoadingMessage, Mode=OneWay}" />

                <ItemsRepeater ItemsSource="{x:Bind Detail.Facts, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:DetailFact">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    FontSize="13"
                                    Foreground="{StaticResource MutedTextBrush}"
                                    Text="{x:Bind Label}" />
                                <TextBlock
                                    Grid.Column="1"
                                    FontSize="13"
                                    IsTextSelectionEnabled="True"
                                    Text="{x:Bind Value}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource CardLabelTextStyle}" Text="PEUX-TU LE SUPPRIMER ?" />
                    <TextBlock
                        FontSize="14"
                        Text="{x:Bind Detail.Advice, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="6" Visibility="{x:Bind Detail.CanHaveChildren, Mode=OneWay}">
                    <TextBlock Style="{StaticResource CardLabelTextStyle}" Text="{x:Bind Detail.ChildrenTitle, Mode=OneWay}" />

                    <ItemsRepeater ItemsSource="{x:Bind Detail.Children, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="2" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:StorageChildRow">
                                <Button
                                    AutomationProperties.Name="{x:Bind Label}"
                                    Click="OnChildClicked"
                                    IsEnabled="{x:Bind CanOpen}"
                                    Style="{StaticResource ChildRowButtonStyle}"
                                    Tag="{x:Bind Usage}">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse
                                                Width="8"
                                                Height="8"
                                                Margin="0,6,0,0"
                                                VerticalAlignment="Top"
                                                Fill="{x:Bind Risk, Converter={StaticResource RiskBrush}}" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind Label}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{StaticResource MutedTextBrush}"
                                                    MaxLines="2"
                                                    Text="{x:Bind Summary}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                            <controls:AnimatedText
                                                Grid.Column="2"
                                                Effect="Decrypt"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind SizeText}" />
                                        </Grid>
                                        <ProgressBar
                                            Height="4"
                                            MinHeight="4"
                                            Style="{StaticResource UsageBarStyle}"
                                            Value="{x:Bind Ratio}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <Button
                    Padding="22,10"
                    Command="{x:Bind Detail.RevealCommand, Mode=OneWay}"
                    Content="Ouvrir dans l'Explorateur"
                    Style="{StaticResource LiquidButtonStyle}"
                    Visibility="{x:Bind Detail.CanReveal, Mode=OneWay}" />
            </StackPanel>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="Wide">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1100" />
                        </VisualState.StateTriggers>
                    </VisualState>
                    <VisualState x:Name="Narrow">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="VisualColumn.Width" Value="*" />
                            <Setter Target="ContentColumn.Width" Value="0" />
                            <Setter Target="ContentPanel.(Grid.Column)" Value="0" />
                            <Setter Target="ContentPanel.(Grid.Row)" Value="1" />
                            <Setter Target="VisualPanel.MinHeight" Value="120" />
                            <Setter Target="GradientBase.CornerRadius" Value="11,11,0,0" />
                            <Setter Target="GradientGlow.CornerRadius" Value="11,11,0,0" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </Border>
</UserControl>
