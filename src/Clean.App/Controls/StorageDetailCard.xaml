<UserControl
    x:Class="Clean.App.Controls.StorageDetailCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Clean.App.Controls"
    xmlns:converters="using:Clean.App.Converters"
    xmlns:viewmodels="using:Clean.App.ViewModels">
    <UserControl.Resources>
        <converters:RiskLevelToBrushConverter x:Key="RiskBrush" />
    </UserControl.Resources>

    <Border
        Background="{StaticResource CardBackgroundBrush}"
        BorderBrush="{StaticResource CardBorderBrush}"
        BorderThickness="1"
        CornerRadius="12">
        <Grid x:Name="Layout">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="VisualColumn" Width="*" />
                <ColumnDefinition x:Name="ContentColumn" Width="2*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid
                x:Name="VisualPanel"
                MinHeight="240"
                Background="#0C0C0E"
                CornerRadius="11,0,0,11">
                <Border
                    x:Name="VisualTint"
                    Background="{x:Bind Detail.Risk, Mode=OneWay, Converter={StaticResource RiskBrush}}"
                    CornerRadius="11,0,0,11"
                    Opacity="0.14" />
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10">
                    <FontIcon
                        FontSize="64"
                        Foreground="{x:Bind Detail.Risk, Mode=OneWay, Converter={StaticResource RiskBrush}}"
                        Glyph="{x:Bind Detail.Glyph, Mode=OneWay}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="26"
                        FontWeight="Bold"
                        Text="{x:Bind Detail.SizeText, Mode=OneWay}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource MutedTextStyle}"
                        Text="{x:Bind Detail.ShareText, Mode=OneWay}" />
                </StackPanel>
            </Grid>

            <StackPanel
                x:Name="ContentPanel"
                Grid.Column="1"
                Padding="28,24,28,28"
                Spacing="16">
                <Grid>
                    <TextBlock
                        VerticalAlignment="Center"
                        CharacterSpacing="60"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{x:Bind Detail.Risk, Mode=OneWay, Converter={StaticResource RiskBrush}}"
                        Text="{x:Bind Detail.Verdict, Mode=OneWay}" />
                    <Button
                        Padding="8"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{x:Bind Detail.CloseCommand, Mode=OneWay}"
                        ToolTipService.ToolTip="Fermer">
                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                    </Button>
                </Grid>

                <StackPanel Spacing="8">
                    <TextBlock
                        FontSize="28"
                        FontWeight="Bold"
                        Text="{x:Bind Detail.Name, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        FontSize="14"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="{x:Bind Detail.Summary, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource CardLabelTextStyle}" Text="PEUX-TU LE SUPPRIMER ?" />
                    <TextBlock
                        FontSize="14"
                        Text="{x:Bind Detail.Advice, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="10" Visibility="{x:Bind Detail.CanHaveChildren, Mode=OneWay}">
                    <TextBlock Style="{StaticResource CardLabelTextStyle}" Text="{x:Bind Detail.ChildrenTitle, Mode=OneWay}" />

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="10"
                        Visibility="{x:Bind Detail.IsLoadingChildren, Mode=OneWay}">
                        <controls:LumaSpin Width="18" Height="18" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource MutedTextStyle}"
                            Text="Analyse du contenu…" />
                    </StackPanel>

                    <TextBlock
                        Style="{StaticResource MutedTextStyle}"
                        Text="{x:Bind Detail.ChildrenMessage, Mode=OneWay}"
                        Visibility="{x:Bind Detail.HasChildrenMessage, Mode=OneWay}" />

                    <ItemsRepeater ItemsSource="{x:Bind Detail.Children, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="10" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:StorageChildRow">
                                <StackPanel Spacing="4">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            FontSize="13"
                                            Text="{x:Bind Label}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Column="1"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind SizeText}" />
                                    </Grid>
                                    <ProgressBar
                                        Height="4"
                                        MinHeight="4"
                                        Style="{StaticResource UsageBarStyle}"
                                        Value="{x:Bind Ratio}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <Button
                    Padding="22,10"
                    Command="{x:Bind Detail.RevealCommand, Mode=OneWay}"
                    Content="Ouvrir dans l'Explorateur"
                    Style="{StaticResource LiquidButtonStyle}"
                    Visibility="{x:Bind Detail.CanReveal, Mode=OneWay}" />
            </StackPanel>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="Wide">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1100" />
                        </VisualState.StateTriggers>
                    </VisualState>
                    <VisualState x:Name="Narrow">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="VisualColumn.Width" Value="*" />
                            <Setter Target="ContentColumn.Width" Value="0" />
                            <Setter Target="ContentPanel.(Grid.Column)" Value="0" />
                            <Setter Target="ContentPanel.(Grid.Row)" Value="1" />
                            <Setter Target="VisualPanel.MinHeight" Value="180" />
                            <Setter Target="VisualPanel.CornerRadius" Value="11,11,0,0" />
                            <Setter Target="VisualTint.CornerRadius" Value="11,11,0,0" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </Border>
</UserControl>
