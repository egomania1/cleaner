<UserControl
    x:Class="Clean.App.Controls.StatCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="6">
            <TextBlock Style="{StaticResource CardLabelTextStyle}" Text="{x:Bind Title, Mode=OneWay}" />
            <TextBlock Style="{StaticResource CardValueTextStyle}" Text="{x:Bind Value, Mode=OneWay}" />
            <TextBlock Style="{StaticResource MutedTextStyle}" Text="{x:Bind Caption, Mode=OneWay}" />
        </StackPanel>
    </Border>
</UserControl>
