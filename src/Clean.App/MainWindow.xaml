<Window
    x:Class="Clean.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Clean.App.Controls"
    Title="Clean">
    <Window.SystemBackdrop>
        <controls:AlwaysActiveAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Loaded="OnRootLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:LineStrands Grid.RowSpan="3" Opacity="0.7" />

        <StackPanel
            x:Name="AppTitleBar"
            Padding="16,0"
            Orientation="Horizontal"
            Spacing="10">
            <Image
                Width="18"
                Height="18"
                VerticalAlignment="Center"
                Source="Assets/Clean.ico" />
            <TextBlock
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="Clean" />
        </StackPanel>

        <controls:GlassNavBar
            x:Name="NavBar"
            Grid.Row="1"
            Margin="16,0,16,12"
            HorizontalAlignment="Center" />

        <Frame x:Name="ContentFrame" Grid.Row="2" />

        <controls:LoadingOverlay
            x:Name="StartupOverlay"
            Grid.RowSpan="3"
            Message="PRÉPARATION" />
    </Grid>
</Window>
