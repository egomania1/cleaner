<Page
    x:Class="Clean.App.Views.StoragePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Clean.App.Controls"
    xmlns:viewmodels="using:Clean.App.ViewModels">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <!-- The content column grows up to 1100px; the side columns share what is left, which keeps it centered. -->
        <Grid Padding="32,8,32,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="100*" MaxWidth="1100" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" Spacing="16">

                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Stockage" />
                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="Ce qui occupe la place sur tes disques." />
                </StackPanel>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ComboBox
                        MinWidth="340"
                        VerticalAlignment="Center"
                        IsEnabled="{x:Bind ViewModel.CanChangeDisk, Mode=OneWay}"
                        ItemsSource="{x:Bind ViewModel.Disks}"
                        SelectedIndex="{x:Bind ViewModel.SelectedDiskIndex, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:DiskItemViewModel">
                                <TextBlock Text="{x:Bind DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button
                        Grid.Column="1"
                        Padding="28,10"
                        Command="{x:Bind ViewModel.AnalyzeCommand}"
                        Content="Analyser"
                        Style="{StaticResource LiquidButtonStyle}" />
                </Grid>

                <TextBlock
                    Foreground="{StaticResource CautionBrush}"
                    Style="{StaticResource MutedTextStyle}"
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}" />

                <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="Choisis un disque puis lance l'analyse pour voir quels dossiers prennent le plus de place." />
                </Border>

                <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}">
                    <StackPanel Spacing="22">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <controls:LumaSpin Width="26" Height="26" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ViewModel.ScanTitle, Mode=OneWay}" />
                            </StackPanel>
                            <Button
                                Padding="22,8"
                                HorizontalAlignment="Right"
                                Command="{x:Bind ViewModel.CancelCommand}"
                                Content="Annuler"
                                Style="{StaticResource LiquidButtonStyle}" />
                        </Grid>

                        <controls:SegmentedProgress Label="Progression estimée" Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Style="{StaticResource CardLabelTextStyle}" Text="FICHIERS ANALYSÉS" />
                                <TextBlock Style="{StaticResource CardValueTextStyle}" Text="{x:Bind ViewModel.FilesScannedText, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Style="{StaticResource CardLabelTextStyle}" Text="DONNÉES ANALYSÉES" />
                                <TextBlock Style="{StaticResource CardValueTextStyle}" Text="{x:Bind ViewModel.DataAnalyzedText, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Style="{StaticResource CardLabelTextStyle}" Text="TEMPS ÉCOULÉ" />
                                <TextBlock Style="{StaticResource CardValueTextStyle}" Text="{x:Bind ViewModel.ElapsedText, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock
                            Style="{StaticResource MutedTextStyle}"
                            Text="{x:Bind ViewModel.CurrentPath, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </StackPanel>
                </Border>

                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay}">
                    <Border Padding="8" Style="{StaticResource CardStyle}">
                        <controls:PolarChart Height="400" Buckets="{x:Bind ViewModel.Buckets, Mode=OneWay}" />
                    </Border>

                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="{x:Bind ViewModel.ResultSummary, Mode=OneWay}" />

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.BucketRows, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="6" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:StorageBucketRow">
                                <Border Padding="14,10" Style="{StaticResource CardStyle}">
                                    <Grid>
                                        <TextBlock Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            FontWeight="Bold"
                                            Text="{x:Bind SizeText}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
