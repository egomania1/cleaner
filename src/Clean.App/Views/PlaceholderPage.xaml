<Page
    x:Class="Clean.App.Views.PlaceholderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Clean.App.Controls">

    <StackPanel
        MaxWidth="1600"
        Padding="32,8,32,32"
        Spacing="16">
        <controls:PageTitle x:Name="Header" />

        <Border Style="{StaticResource CardStyle}">
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource CardLabelTextStyle}" Text="BIENTÔT DISPONIBLE" />
                <TextBlock x:Name="DescriptionText" Style="{StaticResource MutedTextStyle}" />
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
