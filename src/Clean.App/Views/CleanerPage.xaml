<Page
    x:Class="Clean.App.Views.CleanerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Clean.App.Controls"
    xmlns:converters="using:Clean.App.Converters"
    xmlns:viewmodels="using:Clean.App.ViewModels">
    <Page.Resources>
        <converters:RiskLevelToBrushConverter x:Key="RiskBrush" />
    </Page.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <!-- The content column grows up to 1600px; the side columns share what is left, which keeps it centered. -->
        <Grid Padding="32,8,32,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="100*" MaxWidth="1600" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" Spacing="16">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Nettoyage" />
                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="Ce qui peut être nettoyé, et pourquoi." />
                </StackPanel>

                <Border
                    Padding="16,12"
                    BorderBrush="{StaticResource SafeBrush}"
                    BorderThickness="3,0,0,0"
                    Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource CardLabelTextStyle}" Text="MODE SIMULATION" />
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="Clean analyse et explique. Aucun fichier n'est supprimé : les tailles affichées sont ce qu'un nettoyage libérerait." />
                    </StackPanel>
                </Border>

                <controls:ShinyButton
                    HorizontalAlignment="Left"
                    Padding="30,9"
                    Command="{x:Bind ViewModel.AnalyzeCommand}"
                    Content="Analyser" />

                <TextBlock
                    Foreground="{StaticResource CautionBrush}"
                    Style="{StaticResource MutedTextStyle}"
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}" />

                <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="Lance l'analyse pour voir les fichiers temporaires, caches et rapports de plantage que Clean sait reconnaître." />
                </Border>

                <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}">
                    <StackPanel Spacing="18">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <controls:LumaSpin Width="26" Height="26" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="Analyse des emplacements nettoyables…" />
                            </StackPanel>
                            <Button
                                Padding="22,8"
                                HorizontalAlignment="Right"
                                Command="{x:Bind ViewModel.CancelCommand}"
                                Content="Annuler"
                                Style="{StaticResource LiquidButtonStyle}" />
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource CardLabelTextStyle}" Text="FICHIERS EXAMINÉS" />
                                <TextBlock Style="{StaticResource CardValueTextStyle}" Text="{x:Bind ViewModel.FilesScannedText, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Style="{StaticResource CardLabelTextStyle}" Text="DONNÉES EXAMINÉES" />
                                <TextBlock Style="{StaticResource CardValueTextStyle}" Text="{x:Bind ViewModel.DataAnalyzedText, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock
                            Style="{StaticResource MutedTextStyle}"
                            Text="{x:Bind ViewModel.CurrentPath, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </StackPanel>
                </Border>

                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay}">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource CardLabelTextStyle}" Text="RÉCUPÉRABLE" />
                            <TextBlock
                                FontSize="40"
                                FontWeight="Bold"
                                Text="{x:Bind ViewModel.CleanableText, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource MutedTextStyle}" Text="{x:Bind ViewModel.CleanableSummary, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:ScanItemRow">
                                <Border Style="{StaticResource CardStyle}">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock
                                                    FontSize="15"
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind Name}" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    CharacterSpacing="60"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{x:Bind Risk, Converter={StaticResource RiskBrush}}"
                                                    Text="{x:Bind RiskText}" />
                                            </StackPanel>
                                            <TextBlock
                                                FontSize="13"
                                                Foreground="{StaticResource MutedTextBrush}"
                                                Text="{x:Bind Reason}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{StaticResource MutedTextBrush}"
                                                IsTextSelectionEnabled="True"
                                                Opacity="0.8"
                                                Text="{x:Bind Path}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{StaticResource MutedTextBrush}"
                                                Opacity="0.8"
                                                Text="{x:Bind RuleText}" />
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            Spacing="4">
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                FontSize="22"
                                                FontWeight="Bold"
                                                Text="{x:Bind SizeText}" />
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                FontSize="12"
                                                Foreground="{StaticResource MutedTextBrush}"
                                                Text="{x:Bind ActionText}" />
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                FontSize="12"
                                                Foreground="{StaticResource MutedTextBrush}"
                                                Text="{x:Bind SkippedText}"
                                                Visibility="{x:Bind HasSkippedFiles}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
