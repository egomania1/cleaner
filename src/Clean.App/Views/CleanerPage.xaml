<Page
    x:Class="Clean.App.Views.CleanerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Clean.App.Controls"
    xmlns:converters="using:Clean.App.Converters"
    xmlns:viewmodels="using:Clean.App.ViewModels">
    <Page.Resources>
        <converters:RiskLevelToBrushConverter x:Key="RiskBrush" />
    </Page.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <!-- The content column grows up to 1600px; the side columns share what is left, which keeps it centered. -->
        <Grid Padding="32,8,32,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="100*" MaxWidth="1600" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" Spacing="16">
                <StackPanel Spacing="4">
                    <controls:PageTitle Index="02" Text="Nettoyage" />
                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="Ce qui peut être nettoyé, pourquoi, et le nettoyage lui-même." />
                </StackPanel>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ComboBox
                        MinWidth="340"
                        VerticalAlignment="Center"
                        IsEnabled="{x:Bind ViewModel.CanChangeDisk, Mode=OneWay}"
                        ItemsSource="{x:Bind ViewModel.Disks}"
                        SelectedIndex="{x:Bind ViewModel.SelectedDiskIndex, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:DiskItemViewModel">
                                <TextBlock Text="{x:Bind DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <controls:ShinyButton
                        Grid.Column="1"
                        Padding="30,9"
                        Command="{x:Bind ViewModel.AnalyzeCommand}"
                        Content="Analyser" />
                </Grid>

                <TextBlock
                    Foreground="{StaticResource CautionBrush}"
                    Style="{StaticResource MutedTextStyle}"
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}" />

                <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="Choisis un disque puis lance l'analyse. Clean te montre les fichiers temporaires, caches et rapports de plantage qu'il sait reconnaître, puis tu choisis ce qui est supprimé." TextWrapping="Wrap" />
                </Border>

                <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}">
                    <StackPanel Spacing="18">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <controls:LumaSpin Width="26" Height="26" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="Analyse des emplacements nettoyables…" />
                            </StackPanel>
                            <Button
                                Padding="22,8"
                                HorizontalAlignment="Right"
                                Command="{x:Bind ViewModel.CancelCommand}"
                                Content="Annuler"
                                Style="{StaticResource LiquidButtonStyle}" />
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource CardLabelTextStyle}" Text="FICHIERS EXAMINÉS" />
                                <TextBlock Style="{StaticResource CardValueTextStyle}" Text="{x:Bind ViewModel.FilesScannedText, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Style="{StaticResource CardLabelTextStyle}" Text="DONNÉES EXAMINÉES" />
                                <TextBlock Style="{StaticResource CardValueTextStyle}" Text="{x:Bind ViewModel.DataAnalyzedText, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock
                            Style="{StaticResource MutedTextStyle}"
                            Text="{x:Bind ViewModel.CurrentPath, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.IsCleaning, Mode=OneWay}">
                    <StackPanel Spacing="18">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <controls:LumaSpin Width="26" Height="26" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="Nettoyage en cours…" />
                            </StackPanel>
                            <Button
                                Padding="22,8"
                                HorizontalAlignment="Right"
                                Command="{x:Bind ViewModel.CancelCleaningCommand}"
                                Content="Arrêter"
                                Style="{StaticResource LiquidButtonStyle}" />
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource CardLabelTextStyle}" Text="FICHIERS RETIRÉS" />
                                <TextBlock Style="{StaticResource CardValueTextStyle}" Text="{x:Bind ViewModel.CleaningFilesText, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Style="{StaticResource CardLabelTextStyle}" Text="DONNÉES RETIRÉES" />
                                <TextBlock Style="{StaticResource CardValueTextStyle}" Text="{x:Bind ViewModel.CleaningFreedText, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock
                            Style="{StaticResource MutedTextStyle}"
                            Text="{x:Bind ViewModel.CurrentPath, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </StackPanel>
                </Border>

                <Border
                    BorderBrush="{StaticResource SafeBrush}"
                    BorderThickness="3,0,0,0"
                    Style="{StaticResource CardStyle}"
                    Visibility="{x:Bind ViewModel.IsCleaned, Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource CardLabelTextStyle}" Text="RETIRÉ" />
                        <controls:AnimatedText
                            HorizontalAlignment="Left"
                            Effect="CountUp"
                            FontSize="40"
                            FontWeight="Bold"
                            IsShiny="True"
                            Text="{x:Bind ViewModel.FreedText, Mode=OneWay}" />
                        <TextBlock
                            Style="{StaticResource MutedTextStyle}"
                            Text="{x:Bind ViewModel.CleanedSummary, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{StaticResource CautionBrush}"
                            Style="{StaticResource MutedTextStyle}"
                            Text="{x:Bind ViewModel.LockedText, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.HasLockedFiles, Mode=OneWay}" />
                        <TextBlock
                            Style="{StaticResource MutedTextStyle}"
                            Text="{x:Bind ViewModel.KeptRecentText, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.HasKeptRecentFiles, Mode=OneWay}" />
                        <TextBlock
                            Style="{StaticResource MutedTextStyle}"
                            Text="{x:Bind ViewModel.ArchiveText}"
                            TextWrapping="Wrap" />
                        <Button
                            Margin="0,4,0,0"
                            Padding="22,8"
                            Command="{x:Bind ViewModel.ShowHistoryCommand}"
                            Content="Voir l'historique"
                            Style="{StaticResource LiquidButtonStyle}" />
                    </StackPanel>
                </Border>

                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay}">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource CardLabelTextStyle}" Text="RÉCUPÉRABLE" />
                            <controls:AnimatedText
                                HorizontalAlignment="Left"
                                Effect="CountUp"
                                FontSize="40"
                                FontWeight="Bold"
                                IsShiny="True"
                                Text="{x:Bind ViewModel.CleanableText, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource MutedTextStyle}" Text="{x:Bind ViewModel.CleanableSummary, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.HasNothingFound, Mode=OneWay}">
                        <TextBlock
                            Style="{StaticResource MutedTextStyle}"
                            Text="{x:Bind ViewModel.NothingFoundText, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.HasCleanableItems, Mode=OneWay}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Style="{StaticResource CardLabelTextStyle}" Text="SÉLECTION" />
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="{x:Bind ViewModel.SelectionText, Mode=OneWay}" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Padding="16,8"
                                Command="{x:Bind ViewModel.SelectSafeCommand}"
                                Content="Éléments sûrs"
                                Style="{StaticResource LiquidButtonStyle}" />
                            <Button
                                Grid.Column="2"
                                Padding="16,8"
                                Command="{x:Bind ViewModel.SelectAllCommand}"
                                Content="Tout"
                                Style="{StaticResource LiquidButtonStyle}" />
                            <Button
                                Grid.Column="3"
                                Padding="16,8"
                                Command="{x:Bind ViewModel.SelectNoneCommand}"
                                Content="Aucun"
                                Style="{StaticResource LiquidButtonStyle}" />
                            <controls:ShinyButton
                                Grid.Column="4"
                                Padding="30,9"
                                Command="{x:Bind ViewModel.CleanCommand}"
                                Content="{x:Bind ViewModel.CleanButtonText, Mode=OneWay}" />
                        </Grid>
                    </Border>

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:ScanItemRow">
                                <Border Style="{StaticResource CardStyle}">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox
                                            MinWidth="0"
                                            VerticalAlignment="Top"
                                            IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                            IsEnabled="{x:Bind CanSelect}"
                                            ToolTipService.ToolTip="Inclure dans le nettoyage" />

                                        <StackPanel Grid.Column="1" Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock
                                                    FontSize="15"
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind Name}" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    CharacterSpacing="60"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{x:Bind Risk, Converter={StaticResource RiskBrush}}"
                                                    Text="{x:Bind RiskText}" />
                                            </StackPanel>
                                            <TextBlock
                                                FontSize="13"
                                                Foreground="{StaticResource MutedTextBrush}"
                                                Text="{x:Bind Reason}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{StaticResource MutedTextBrush}"
                                                IsTextSelectionEnabled="True"
                                                Opacity="0.8"
                                                Text="{x:Bind Path}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{StaticResource MutedTextBrush}"
                                                Opacity="0.8"
                                                Text="{x:Bind RuleText}" />
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Column="2"
                                            HorizontalAlignment="Right"
                                            Spacing="4">
                                            <controls:AnimatedText
                                                HorizontalAlignment="Right"
                                                Effect="Decrypt"
                                                FontSize="22"
                                                FontWeight="Bold"
                                                Text="{x:Bind SizeText}" />
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                FontSize="12"
                                                Foreground="{StaticResource MutedTextBrush}"
                                                Text="{x:Bind ActionText}" />
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                FontSize="12"
                                                Foreground="{StaticResource MutedTextBrush}"
                                                Text="{x:Bind SkippedText}"
                                                Visibility="{x:Bind HasSkippedFiles}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
